  "scope": "Batches 1 and 2 are implemented and validated. Batches 3 and 4 remain prioritized follow-up work.",
  "batch_rationale": {
    "1": "Correct existing public contracts that can replay the wrong work or truncate data; all are supported by the pinned engine.",
    "2": "Complete operational controls and run discovery; negotiate engine capabilities before enabling newer controls.",
    "3": "Add production observability and submission guarantees; expand live contract coverage across prior batches.",
    "4": "Add newer execution modes and language-specific conveniences after checking engine prerequisites."
  },
  "batch_1_acceptance": [
    "Fresh clients resolve named task external IDs from the engine, excluding unstarted task placeholders.",
    "Branch sends taskExternalId, nodeId and branchId to the durable branch endpoint and preserves the returned checkpoint.",
    "Restore calls the evicted-task restore endpoint and returns the requeue outcome without replaying a run.",
    "Streaming yields events as they arrive, survives idle gaps and lasts until completion/cancellation; tests cover errors and consumer drop.",
    "Actual pinned-engine tests exercise recovery and streaming; focused protocol tests prove wire shapes and failure paths."
  ],
